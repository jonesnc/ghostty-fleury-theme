# Fleury Warm
# Same as the fleury theme, but with the lighter warm-black background.
# Flip between them: theme = fleury (near black) or theme = fleury-warm.
# Ghostty port of Ryan Fleury's 4coder theme, softened for long sessions.
# Faithful colors are in the fleury-4coder theme. Changes here:
#   - warm near-black background #151311 instead of #020202 (less glare and halation)
#   - foreground between faithful #b99468 and the earlier softened #d2b58c
#   - saturation of the neon greens, cyans, and blues cut to 45-60%
#   - dark red lifted to at least 4.5:1
#   - cyan pulled toward teal so it reads apart from green
#   - cursor is faithful 4coder green, bold-color stays gold
#   - selection is the cool slate of 4coder defcolor_highlight
# Created 2026-10-20 from fleury. Only background, unfocused-split-fill, and palette 0 differ.

background = #151311
foreground = #c4a279
cursor-color = #00ee00
cursor-text = #0c0c0c
bold-color = #f5b03a
selection-background = #303040
selection-foreground = #f0cf85

# Splits: 4coder margin_active brown for the divider, near-black for unfocused panes.
split-divider-color = #63523d
unfocused-split-fill = #0c0b0a
unfocused-split-opacity = 0.85

# Search: 4coder fleury_color_token_highlight gold for matches, token_minor_highlight
# orange for the current match. Dark text on both.
search-background = #f2d357
search-foreground = #020202
search-selected-background = #d19045
search-selected-foreground = #020202

# black:   background / defcolor_margin_active brown. Claude Code dark-ansi paints the
#          user-message band with bright black, so this must stay dark. fish
#          autosuggestions use it too and read faint on purpose.
palette = 0=#151311
palette = 8=#63523d
# red:     operators / functions
palette = 1=#d4544d
palette = 9=#e8704a
# green:   comment pop / sum type
palette = 2=#5cbf72
palette = 10=#b4d65e
# yellow:  strings / keywords
palette = 3=#f5b03a
palette = 11=#f0cf85
# blue:    macros / plot cycle
palette = 4=#5aa6cf
palette = 12=#7fcbe6
# magenta: declarations / cursor purple
palette = 5=#d07aa2
palette = 13=#c48bd0
# cyan:    cursor teal / brace highlight
palette = 6=#4fc0b8
palette = 14=#a6e3d6
# white:   defcolor_text_default faithful (Claude Code "subtle") / keyword pale yellow (Claude Code "text").
#          4coder has no white. Gold lives in bold-color and yellow.
palette = 7=#b99468
palette = 15=#f0cf85
